<!doctype html>
<html lang="en">
  <%- include('partials/header', { title: 'Projects | Alex Draesner' }) %>

  <body class="projects-body">
    <%- include('partials/nav') %>

    <main class="projects-page">
      <header class="projects-hero">
        <p class="projects-eyebrow">Selected work</p>

        <h1>Projects</h1>

        <p class="projects-intro">
          A selection of projects from my Software Engineering studies and
          personal development work.
        </p>
      </header>

      <section class="projects-list-section" aria-labelledby="projects-heading">
        <div class="section-heading">
          <p class="section-label">Explore my work</p>
          <h2 id="projects-heading">Things I’ve built and explored</h2>
        </div>

        <div class="projects-grid">
          <% if (projects.length === 0) { %>
            <article class="projects-empty-state">
              <h2>No projects yet</h2>
              <p>
                Projects will appear here once they have been added.
              </p>
            </article>
          <% } else { %>
            <% projects.forEach(function(project) { %>
              <% const description = project.description || '' %>
              <% const notionMatch = description.match(/(https?:\/\/\S+)/) %>
              <% const cleanDescription = notionMatch
                ? description.replace(notionMatch[1], '').trim()
                : description %>

              <% let fallbackImage = null %>
              <% if (project.slug === '3d-printing') {
                fallbackImage = '/3d-pager.png'
              } else if (project.slug === 'web-development') {
                fallbackImage = '/website-code.png'
              } %>

              <article class="project-card">
                <a
                  class="project-card-visual"
                  href="/project/<%= project.slug %>"
                  aria-label="View <%= project.name %> project"
                >
                  <% if (project.image || fallbackImage) { %>
                    <img
                      src="<%= project.image || fallbackImage %>"
                      alt="<%= project.name %> project preview"
                    />
                  <% } else { %>
                    <span class="project-card-placeholder">
                      <%= project.name %>
                    </span>
                  <% } %>
                </a>

                <div class="project-card-content">
                  <p class="project-card-label">Project</p>

                  <h3>
                    <a href="/project/<%= project.slug %>">
                      <%= project.name %>
                    </a>
                  </h3>

                  <p class="project-card-description">
                    <%= cleanDescription || 'Explore this project to learn more.' %>
                  </p>

                  <div class="project-card-footer">
                    <a
                      class="project-card-link"
                      href="/project/<%= project.slug %>"
                    >
                      View project →
                    </a>

                    <% if (notionMatch) { %>
                      <a
                        class="project-card-external-link"
                        href="<%= notionMatch[1].trim() %>"
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        More details
                      </a>
                    <% } %>
                  </div>

                  <div class="project-admin-actions">
                    <a href="/project/<%= project.slug %>/edit">Edit</a>

                    <form
                      action="/project/<%= project.slug %>/delete"
                      method="POST"
                    >
                      <button type="submit">Delete</button>
                    </form>
                  </div>
                </div>
              </article>
            <% }) %>
          <% } %>
        </div>
      </section>

      <section class="projects-footer">
        <div>
          <p class="section-label">More to come</p>

          <h2>Continuing to build</h2>

          <p>
            I’m continuing to add projects as I develop my skills through
            coursework and personal practice.
          </p>
        </div>

        <a class="projects-add-button" href="/projects/new">
          Add new project
        </a>
      </section>
    </main>
  </body>
</html>