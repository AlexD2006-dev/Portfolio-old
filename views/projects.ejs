<!doctype html>
<html lang="en">
  <%- include('partials/header', { title: 'Projects | Alex Draesner' }) %>

  <body class="projects-body">
    <%- include('partials/nav') %>

    <main class="projects-page">
      <header class="projects-hero">
        <p class="projects-eyebrow">Selected work</p>

        <h1>Projects</h1>

        <p class="projects-intro">
          A selection of projects from my Software Engineering studies and
          personal development work.
        </p>
      </header>

      <section
        class="projects-list-section"
        aria-labelledby="projects-heading"
      >
        <div class="section-heading">
          <p class="section-label">Explore my work</p>

          <h2 id="projects-heading">
            Things I’ve built and explored
          </h2>
        </div>

        <div class="projects-grid">
          <% if (projects.length === 0) { %>
            <article class="projects-empty-state">
              <h2>No projects yet</h2>

              <p>
                Projects will appear here once they have been added.
              </p>
            </article>
          <% } else { %>
            <% projects.forEach(function(project) { %>
              <% const description = project.description || '' %>
              <% const notionMatch = description.match(/(https?:\/\/\S+)/) %>

              <% let projectImage = project.image || null %>

              <% if (project.slug === '3d-printing') {
                projectImage = '/3d-pager.png'
              } else if (project.slug === 'web-development') {
                projectImage = '/alex-blog.png'
              } %>

              <article class="project-card">
                <a
                  class="project-card-visual"
                  href="/project/<%= project.slug %>"
                  aria-label="View <%= project.name %> project"
                >
                  <% if (projectImage) { %>
                    <img
                      src="<%= projectImage %>"
                      alt="<%= project.name %> project preview"
                    />
                  <% } else { %>
                    <span class="project-card-placeholder">
                      <%= project.name %>
                    </span>
                  <% } %>
                </a>

                <div class="project-card-content">
                  <p class="project-card-label">Project</p>

                  <h3>
                    <a href="/project/<%= project.slug %>">
                      <% if (project.slug === '3d-printing') { %>
                        3D Printing — InsightOut
                      <% } else if (project.slug === 'web-development') { %>
                        AlexBlog
                      <% } else { %>
                        <%= project.name %>
                      <% } %>
                    </a>
                  </h3>

                  <% if (project.slug === '3d-printing') { %>
                    <p class="project-card-description">
                      A university project exploring 3D design, physical
                      prototyping, and 3D printing. I created the models,
                      handled most of the printing, and iterated on the design.
                    </p>
                  <% } else if (project.slug === 'web-development') { %>
                    <p class="project-card-description">
                      A private full-stack blog built with Node.js, Express,
                      EJS, HTML, and CSS. It includes multiple pages, blog
                      content, and a contact form.
                    </p>
                  <% } else { %>
                    <p class="project-card-description">
                      <%= description || 'Explore this project to learn more.' %>
                    </p>
                  <% } %>

                  <div class="project-card-footer">
                    <a
                      class="project-card-link"
                      href="/project/<%= project.slug %>"
                    >
                      View project →
                    </a>

                    <% if (notionMatch) { %>
                      <a
                        class="project-card-external-link"
                        href="<%= notionMatch[1].trim() %>"
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        More details
                      </a>
                    <% } %>
                  </div>
                </div>
              </article>
            <% }) %>
          <% } %>
        </div>
      </section>

      <section class="projects-footer">
        <div>
          <p class="section-label">More to come</p>

          <h2>Continuing to build</h2>

          <p>
            I’m continuing to add projects as I develop my skills through
            coursework and personal practice.
          </p>
        </div>
      </section>
    </main>
  </body>
</html>